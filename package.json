{
  "name": "booker",
  "version": "0.72.7",
  "description": "Write multi-book novels in Obsidian: series, codex, timeline, plotlines, stats and Word/ePub/PDF export.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "install-plugin": "node scripts/install.mjs",
    "testvault": "npm run build && node scripts/install.mjs TestVault --enable",
    "package": "npm run build && node scripts/build-guide.mjs && node scripts/package.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/sql.js": "^1.4.11",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.3",
    "marked": "^18.1.1",
    "obsidian": "latest",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "d3-scale": "^4.0.2",
    "docx": "^9.0.0",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.18.0",
    "pdf-lib": "^1.17.1",
    "sql.js": "^1.13.0",
    "stemmer": "^2.0.1"
  }
}
